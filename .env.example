DISCORD_BOT_TOKEN=
BOT_NAME=WoW Bot
AI_MODEL=gpt-6.1-sol
AI_REASONING=low
AI_COMPACT_THRESHOLD=24000
AUTH_FILE=.data/auth.json
DATABASE_FILE=.data/conversations.sqlite
# Empty allowlists permit everyone. Each configured list must match.
DISCORD_ALLOWED_GUILD_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_USER_IDS=
# Set false to disable DMs independently of server access.
DISCORD_ALLOW_DMS=true
