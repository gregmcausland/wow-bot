{
  "name": "wow-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "auth:login": "tsx src/auth.ts login",
    "auth:status": "tsx src/auth.ts status",
    "auth:logout": "tsx src/auth.ts logout",
    "models": "tsx src/auth.ts models",
    "test:compaction:live": "tsx spikes/compaction/run.ts",
    "test:compaction:integration": "tsx spikes/compaction/integration.ts",
    "eval:scope": "tsx evals/run.ts",
    "test:tools:live": "tsx spikes/tools/run.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.98",
    "ai": "^7.0.146",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.8",
    "jose": "^6.2.13",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
